{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "message_text": {
      "type": "string",
      "description": "The message content"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "sender_role": {
      "type": "string",
      "description": "Role of the sender"
    },
    "chat_type": {
      "type": "string",
      "enum": [
        "general",
        "private"
      ],
      "default": "general",
      "description": "Type of chat message"
    },
    "conversation_id": {
      "type": "string",
      "description": "ID of the private conversation (null for general chat)"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of emails who have read this message",
      "default": []
    }
  },
  "required": [
    "message_text",
    "sender_email",
    "sender_name",
    "chat_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "operator"
          }
        },
        {
          "data.chat_type": "general"
        },
        {
          "data.conversation_id": {
            "$exists": true
          },
          "data.participant_emails": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "operator"
          }
        },
        {
          "data.sender_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}